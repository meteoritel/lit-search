# 项目本地配置（扁平 KEY=VALUE）。复制为 .env 后按需填写，不要提交真实 key。
#
# 逐键取首个命中：环境变量 → LITSEARCH_CONFIG → 用户级 config.toml
# → 当前目录 litsearch.toml → 本文件。LITSEARCH_CONFIG 仅从环境变量读取。
# TOML 支持 output_dir、default_sources、[api_keys] 和 [presets]；
# 本文件只提供下列扁平键的回退值。

# OpenAlex API key（检索该来源时必需）。申请：https://openalex.org/settings/api
OPENALEX_API_KEY=

# Crossref 联系邮箱（可选，进入礼貌池，请求更稳定）
CROSSREF_MAILTO=

# 默认输出目录（可选；不设则为 <当前目录>/output）
LITSEARCH_OUTPUT_DIR=
