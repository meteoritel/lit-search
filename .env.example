# 项目本地配置（扁平 KEY=VALUE）。复制为 .env 后按需填写，不要提交真实 key。
#
# 逐键取首个命中：环境变量 → 用户级 config.toml → 项目 litsearch.toml → 本文件
# 结构化配置（output_dir / default_sources / [api_keys] / [presets]）只能来自 TOML，
# 其中 [presets] 请写在项目根的 litsearch.toml 里；本文件只提供扁平键回退。

# OpenAlex API key（必需）。申请：https://openalex.org/settings/api
OPENALEX_API_KEY=

# Crossref 联系邮箱（可选，进入礼貌池，请求更稳定）
CROSSREF_MAILTO=

# 默认输出目录（可选；不设则为 <当前目录>/output）
LITSEARCH_OUTPUT_DIR=

# 指定用户级 config.toml 路径（可选）
# LITSEARCH_CONFIG=
